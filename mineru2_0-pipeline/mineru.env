# ============================================
# MinerU 模型配置
# ============================================
# 设置使用本地模型
MINERU_MODEL_SOURCE=local

# 使用 pp_formulanet_plus_m (中文) unimernet_small (英文)
MINERU_FORMULA_CH_SUPPORT=False

# 配置文件路径（Docker 环境使用容器内路径，本地开发使用绝对路径）
# Docker: /app/mineru.json
# Local:  /home/caixj/projects-code/mineru2_5-pipeline/mineru.json
MINERU_TOOLS_CONFIG_JSON=/app/mineru.json

# 可选: 显存限制 (GB)
# MINERU_VIRTUAL_VRAM_SIZE=6

# ============================================
# Worker 配置
# ============================================
# 每个 GPU 启动的 worker 数量（默认: 1）
# 建议根据显存大小调整: 
#   - 8GB 显卡: 1 worker
#   - 12GB 显卡: 1-2 workers
#   - 24GB 显卡: 2-3 workers
WORKERS_PER_DEVICE=1

# 使用的 GPU 设备（逗号分隔，默认: auto 使用所有 GPU）
# 示例: 
#   - auto: 使用所有可用的 GPU
#   - 0: 只使用 GPU 0
#   - 0,1: 使用 GPU 0 和 1
DEVICES=auto

# 加速器类型（默认: auto）
# 可选值: auto, cuda, cpu, mps
#   - auto: 自动检测
#   - cuda: NVIDIA GPU
#   - cpu: CPU 模式（无 GPU 或测试用）
#   - mps: Apple Silicon (M1/M2/M3)
ACCELERATOR=auto

# ============================================
# 服务端口配置
# ============================================
# API Server 端口（默认: 8000）
API_PORT=8000

# Worker Server 端口（默认: 9000）
WORKER_PORT=9000

# ============================================
# 文件清理配置
# ============================================
# 自动清理多少天前的结果文件（0=禁用，默认: 7天）
CLEANUP_OLD_FILES_DAYS=3

# ============================================
# 可选: MinIO 配置（如果需要图片上传功能）
# ============================================
# MINIO_ENDPOINT=your-endpoint.com
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=your-bucket