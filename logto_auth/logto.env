LOGTO_IMAGE=svhd/logto:latest

LOGTO_DB_USER=logto
LOGTO_DB_PASSWORD=logto_password
LOGTO_DB_NAME=logto
LOGTO_POSTGRES_VERSION=14-alpine

LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
LOGTO_TRUST_PROXY_HEADER=1
LOGTO_DATABASE_STATEMENT_TIMEOUT=DISABLE_TIMEOUT

LOGTO_DATA_PATH=.
TZ=Asia/Shanghai
