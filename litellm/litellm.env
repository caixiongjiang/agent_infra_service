# LiteLLM Proxy
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
LITELLM_PORT=4000
STORE_MODEL_IN_DB=True

# 专用于本 Compose 的 PostgreSQL（与 LiteLLM 使用同一组账号）
LITELLM_DB_USER=llmproxy
LITELLM_DB_PASSWORD=dbpassword9090
LITELLM_DB_NAME=litellm
LITELLM_POSTGRES_VERSION=16
# 与宿主机其他 PostgreSQL 冲突时可改为 5433 等
LITELLM_POSTGRES_HOST_PORT=5432

# 数据目录：持久化在 ${LITELLM_DATA_PATH}/data/postgres
LITELLM_DATA_PATH=.
TZ=Asia/Shanghai

# Proxy 全局设置见同目录 config.yaml（drop_params / modify_params）。
# docker-compose 会挂载 config.yaml 并通过 --config 启动。

# 以下为官方常用变量，按需取消注释并在部署时填写
# LITELLM_MASTER_KEY=sk-...
# LITELLM_SALT_KEY=...
# 其他 PROVIDER API Keys 等，参见 https://docs.litellm.ai/docs/proxy/configs
